# Pipeline output. These are large and reproducible - `downloads/` and
# `remixes/` are regenerated by re-running the commands, and `library/` is
# rebuilt by `faceless harvest`. A single harvest run is already ~500MB of
# video, so none of it belongs in git.
downloads/
library/
remixes/

# Media, wherever it lands
*.mp4
*.mkv
*.webm
*.m4a
*.mp3
*.opus
*.part
*.ytdl

# Sidecars written next to media
*.vtt
*.srt
*.info.json
*.meta.json

# Cookie exports - these are live session credentials
cookies.txt
*.cookies

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
